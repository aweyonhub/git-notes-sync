# binaries (local build output)
/gns
/gns.exe
/dist

# build artifacts
/.build/
*.test

# npm: platform sub-packages — bin/ is 100% generated by assemble script
/packages/*/bin/

# npm: legacy install-script shell (binary downloaded only if install.js run manually)
/npm/bin/gns
/npm/bin/gns.exe

# npm: local artifacts & deps
node_modules/
*.tgz
package-lock.json
.tmp-*/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# logs
*.log
